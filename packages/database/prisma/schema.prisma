generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationType {
  MUNICIPALITY
  INTERNET_PROVIDER
  PLATFORM_OPERATOR
  AUDIT_ORGANIZATION
  FINANCIAL_OPERATOR
  SERVICE_PROVIDER
}

enum OrganizationStatus {
  ONBOARDING
  ACTIVE
  RESTRICTED
  SUSPENDED
  OFFBOARDING
  TERMINATED
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum ParticipationType {
  MUNICIPAL_MANAGER
  INTERNET_PROVIDER
  AUDITOR
  FINANCIAL_OPERATOR
  SERVICE_PROVIDER
}

enum ParticipationStatus {
  PENDING
  ACTIVE
  RESTRICTED
  SUSPENDED
  TERMINATED
}

enum MembershipRole {
  ORGANIZATION_OWNER
  ORGANIZATION_ADMIN
  MUNICIPAL_MANAGER
  MUNICIPAL_OPERATOR
  PROVIDER_MANAGER
  PROVIDER_OPERATOR
  AUDITOR
  SUPPORT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum BeneficiaryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ELIGIBLE
  INELIGIBLE
  REFERRED
  CANCELLED
}

enum ProviderReferralStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum FtthFeasibilityResult {
  FEASIBLE
  EXPANSION_REQUIRED
  NOT_FEASIBLE
}

enum InstallationStatus {
  INSTALLATION_PENDING
  SCHEDULED
  IN_PROGRESS
  INSTALLED
  ACTIVATED
  FAILED
  CANCELLED
}

enum ServiceStatus {
  ACTIVE
  SUSPENDED
  INTERRUPTED
  ENDED
}

enum EvidenceClassification {
  PUBLIC
  INTERNAL
  PERSONAL
  SENSITIVE
}

model Tenant {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String
  status TenantStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organizations TenantOrganization[]
  programs Program[]
  beneficiaries Beneficiary[]
  applications Application[]
  referrals ProviderReferral[]
  feasibilityAssessments FtthFeasibilityAssessment[]
  installationOrders InstallationOrder[]
  activeServices ActiveService[]
  auditLogs AuditLog[]
  evidenceDocuments EvidenceDocument[]
}

model Organization {
  id String @id @default(uuid()) @db.Uuid
  legalName String
  tradeName String?
  documentNumber String?
  type OrganizationType
  status OrganizationStatus @default(ONBOARDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantLinks TenantOrganization[]
  units OrganizationalUnit[]
  memberships Membership[]
  participations ProgramParticipation[]
  municipalPrograms Program[] @relation("MunicipalityPrograms")
  municipalBeneficiaries Beneficiary[] @relation("MunicipalityBeneficiaries")
  municipalApplications Application[] @relation("MunicipalityApplications")
  municipalReferrals ProviderReferral[] @relation("MunicipalityReferrals")
  providerReferrals ProviderReferral[] @relation("ProviderReferrals")
  providerFeasibilityAssessments FtthFeasibilityAssessment[] @relation("ProviderFeasibilityAssessments")
  municipalInstallationOrders InstallationOrder[] @relation("MunicipalityInstallationOrders")
  providerInstallationOrders InstallationOrder[] @relation("ProviderInstallationOrders")
  municipalActiveServices ActiveService[] @relation("MunicipalityActiveServices")
  providerActiveServices ActiveService[] @relation("ProviderActiveServices")
  activeSessions Session[] @relation("ActiveOrganizationContext")
  auditLogs AuditLog[]
  evidenceDocuments EvidenceDocument[]
  @@index([type, status])
}

model TenantOrganization {
  tenantId String @db.Uuid
  organizationId String @db.Uuid
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@id([tenantId, organizationId])
  @@index([organizationId])
}

model OrganizationalUnit {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  name String
  code String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model Program {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  municipalityOrganizationId String @db.Uuid
  name String
  slug String
  status ProgramStatus @default(DRAFT)
  startsAt DateTime?
  endsAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  municipalityOrganization Organization @relation("MunicipalityPrograms", fields: [municipalityOrganizationId], references: [id], onDelete: Restrict)
  participations ProgramParticipation[]
  applications Application[]
  referrals ProviderReferral[]
  installationOrders InstallationOrder[]
  activeServices ActiveService[]
  auditLogs AuditLog[]
  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([municipalityOrganizationId])
}

model ProgramParticipation {
  id String @id @default(uuid()) @db.Uuid
  programId String @db.Uuid
  organizationId String @db.Uuid
  type ParticipationType
  status ParticipationStatus @default(PENDING)
  validFrom DateTime?
  validUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@unique([programId, organizationId, type])
  @@index([organizationId, status])
}

model Beneficiary {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  municipalityOrganizationId String @db.Uuid
  fullName String
  documentHash String
  documentLast4 String @db.VarChar(4)
  birthDate DateTime?
  phone String?
  email String?
  status BeneficiaryStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  municipalityOrganization Organization @relation("MunicipalityBeneficiaries", fields: [municipalityOrganizationId], references: [id], onDelete: Restrict)
  applications Application[]
  @@unique([tenantId, documentHash])
  @@index([municipalityOrganizationId, status])
  @@index([tenantId, createdAt])
}

model Application {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  municipalityOrganizationId String @db.Uuid
  programId String @db.Uuid
  beneficiaryId String @db.Uuid
  status ApplicationStatus @default(SUBMITTED)
  submittedAt DateTime @default(now())
  reviewedAt DateTime?
  decisionReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  municipalityOrganization Organization @relation("MunicipalityApplications", fields: [municipalityOrganizationId], references: [id], onDelete: Restrict)
  program Program @relation(fields: [programId], references: [id], onDelete: Restrict)
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  referrals ProviderReferral[]
  @@unique([programId, beneficiaryId])
  @@index([tenantId, status, submittedAt])
  @@index([municipalityOrganizationId, status])
  @@index([beneficiaryId, createdAt])
}

model ProviderReferral {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  municipalityOrganizationId String @db.Uuid
  providerOrganizationId String @db.Uuid
  programId String @db.Uuid
  applicationId String @db.Uuid
  status ProviderReferralStatus @default(PENDING)
  referredAt DateTime @default(now())
  respondedAt DateTime?
  responseReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  municipalityOrganization Organization @relation("MunicipalityReferrals", fields: [municipalityOrganizationId], references: [id], onDelete: Restrict)
  providerOrganization Organization @relation("ProviderReferrals", fields: [providerOrganizationId], references: [id], onDelete: Restrict)
  program Program @relation(fields: [programId], references: [id], onDelete: Restrict)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  feasibilityAssessment FtthFeasibilityAssessment?
  installationOrder InstallationOrder?
  @@index([tenantId, status, referredAt])
  @@index([municipalityOrganizationId, status])
  @@index([providerOrganizationId, status, referredAt])
  @@index([applicationId, createdAt])
}

model FtthFeasibilityAssessment {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  providerOrganizationId String @db.Uuid
  referralId String @unique @db.Uuid
  result FtthFeasibilityResult
  coverageConfirmed Boolean
  infrastructureReference String?
  availablePorts Int?
  estimatedDropMeters Int?
  expansionRequired Boolean @default(false)
  technicalReason String?
  estimatedReadyAt DateTime?
  assessedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  providerOrganization Organization @relation("ProviderFeasibilityAssessments", fields: [providerOrganizationId], references: [id], onDelete: Restrict)
  referral ProviderReferral @relation(fields: [referralId], references: [id], onDelete: Restrict)
  @@index([tenantId, result, assessedAt])
  @@index([providerOrganizationId, result, assessedAt])
}

model InstallationOrder {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  municipalityOrganizationId String @db.Uuid
  providerOrganizationId String @db.Uuid
  programId String @db.Uuid
  referralId String @unique @db.Uuid
  status InstallationStatus @default(INSTALLATION_PENDING)
  scheduledAt DateTime?
  startedAt DateTime?
  installedAt DateTime?
  activatedAt DateTime?
  failureReason String?
  cancellationReason String?
  externalServiceReference String?
  installationSummary String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  municipalityOrganization Organization @relation("MunicipalityInstallationOrders", fields: [municipalityOrganizationId], references: [id], onDelete: Restrict)
  providerOrganization Organization @relation("ProviderInstallationOrders", fields: [providerOrganizationId], references: [id], onDelete: Restrict)
  program Program @relation(fields: [programId], references: [id], onDelete: Restrict)
  referral ProviderReferral @relation(fields: [referralId], references: [id], onDelete: Restrict)
  activeService ActiveService?
  @@index([tenantId, status, createdAt])
  @@index([municipalityOrganizationId, status, createdAt])
  @@index([providerOrganizationId, status, createdAt])
  @@index([programId, status, createdAt])
}

model ActiveService {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  municipalityOrganizationId String @db.Uuid
  providerOrganizationId String @db.Uuid
  programId String @db.Uuid
  installationOrderId String @unique @db.Uuid
  status ServiceStatus @default(ACTIVE)
  activatedAt DateTime
  suspendedAt DateTime?
  interruptedAt DateTime?
  restoredAt DateTime?
  endedAt DateTime?
  statusReason String?
  externalServiceReference String?
  lastObservedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  municipalityOrganization Organization @relation("MunicipalityActiveServices", fields: [municipalityOrganizationId], references: [id], onDelete: Restrict)
  providerOrganization Organization @relation("ProviderActiveServices", fields: [providerOrganizationId], references: [id], onDelete: Restrict)
  program Program @relation(fields: [programId], references: [id], onDelete: Restrict)
  installationOrder InstallationOrder @relation(fields: [installationOrderId], references: [id], onDelete: Restrict)
  @@index([tenantId, status, createdAt])
  @@index([municipalityOrganizationId, status, createdAt])
  @@index([providerOrganizationId, status, createdAt])
  @@index([programId, status, createdAt])
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  displayName String?
  passwordHash String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  sessions Session[]
  auditLogs AuditLog[]
}

model Membership {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  organizationId String @db.Uuid
  role MembershipRole
  status MembershipStatus @default(INVITED)
  validFrom DateTime?
  validUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([userId, organizationId, role])
  @@index([organizationId, status])
  @@index([userId, status])
}

model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique
  activeOrganizationContextId String? @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationContext Organization? @relation("ActiveOrganizationContext", fields: [activeOrganizationContextId], references: [id], onDelete: Restrict)
  @@index([userId, expiresAt])
  @@index([activeOrganizationContextId])
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  organizationId String? @db.Uuid
  programId String? @db.Uuid
  actorUserId String? @db.Uuid
  action String
  entityType String
  entityId String?
  correlationId String?
  createdAt DateTime @default(now())
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([tenantId, createdAt])
  @@index([organizationId, createdAt])
  @@index([programId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([correlationId])
}


model EvidenceDocument {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  organizationId String @db.Uuid
  entityType String
  entityId String
  purpose String
  classification EvidenceClassification
  originalFileName String?
  mimeType String
  byteSize Int
  sha256 String @db.VarChar(64)
  storageKey String
  retentionUntil DateTime?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@unique([tenantId, storageKey])
  @@index([tenantId, entityType, entityId, createdAt])
  @@index([organizationId, classification, createdAt])
  @@index([retentionUntil])
}
