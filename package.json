{
  "name": "quero-internet",
  "version": "0.1.0",
  "private": true,
  "description": "Quero Internet GovTech — plataforma pública multiempresa para programas de conectividade e inclusão digital.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.14.0",
  "engines": {"node": ">=22 <25", "pnpm": ">=10.14 <11"},
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @quero-internet/database db:generate",
    "db:validate": "pnpm --filter @quero-internet/database db:validate",
    "db:migrate:dev": "pnpm --filter @quero-internet/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @quero-internet/database db:migrate:deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.18",
      "deepmerge-ts": "8.0.0",
      "next": "15.5.24",
      "react": "19.1.2",
      "react-dom": "19.1.2",
      "@nestjs/common": "^11.1.22",
      "@nestjs/core": "^11.1.22",
      "@nestjs/platform-express": "^11.1.22"
    }
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3"
  }
}
