# Copie para um secret manager ou arquivo local fora do Git.
# Nunca use estes valores literalmente.

HOMOLOG_POSTGRES_DB=quero_internet_homolog
HOMOLOG_POSTGRES_USER=quero_internet_homolog
HOMOLOG_POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
HOMOLOG_REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
HOMOLOG_MINIO_ROOT_USER=REPLACE_WITH_UNIQUE_USER
HOMOLOG_MINIO_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET

# Seed sintético (somente homologação)
APP_ENV=homolog
ALLOW_SYNTHETIC_SEED=true
HOMOLOG_SEED_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
HOMOLOG_API_URL=https://homolog.example.invalid
