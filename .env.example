NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
DATABASE_URL=postgresql://quero_internet:change_me@localhost:5432/quero_internet
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=quero-internet-local
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me
BENEFICIARY_IDENTITY_PEPPER=change_me_with_at_least_32_random_characters
LOG_LEVEL=info
CORRELATION_HEADER=x-correlation-id

# ERPs dos provedores (IXC/SGP) — somente leitura, missão 1.12b.
# Kill switch: com "false" (padrão) todas as integrações rodam simuladas.
ERP_REAL_READS_ENABLED=false
# Conexões homologadas por organização provedora. Guardar no cofre de segredos do deploy, nunca no repositório.
# [{"provider":"IXC","organizationId":"<uuid>","baseUrl":"https://ixc.provedor.com.br","user":"12","token":"..."},
#  {"provider":"SGP","organizationId":"<uuid>","baseUrl":"https://provedor.sgp.net.br","token":"...","app":"QUERO"}]
ERP_CONNECTIONS_JSON=
