NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
DATABASE_URL=postgresql://quero_internet:change_me@localhost:5432/quero_internet
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=quero-internet-local
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me
BENEFICIARY_IDENTITY_PEPPER=change_me_with_at_least_32_random_characters
LOG_LEVEL=info
CORRELATION_HEADER=x-correlation-id

# ERPs dos provedores (IXC/SGP) — somente leitura, missão 1.12b.
# Kill switch: com "false" (padrão) a conciliação roda simulada. O botão "Testar conexão" da tela funciona mesmo assim.
ERP_REAL_READS_ENABLED=false
# Chave que cifra os tokens de ERP cadastrados na tela de Integrações (AES-256-GCM).
# Gere com: openssl rand -base64 32 — guarde no cofre de segredos; sem ela o cadastro responde 503.
# Trocar a chave invalida os tokens já salvos (o provedor precisa informá-los de novo).
INTEGRATION_ENCRYPTION_KEY=
# Reserva de implantação: conexões por organização provedora, usadas só quando a tela não tem cadastro.
# [{"provider":"IXC","organizationId":"<uuid>","baseUrl":"https://ixc.provedor.com.br","user":"12","token":"..."},
#  {"provider":"SGP","organizationId":"<uuid>","baseUrl":"https://provedor.sgp.net.br","token":"...","app":"QUERO"}]
ERP_CONNECTIONS_JSON=
